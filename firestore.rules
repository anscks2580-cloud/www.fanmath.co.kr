rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ── 헬퍼 함수 ──────────────────────────────
    // 로그인한 실제 계정(이메일·비밀번호). 상담 방문자용 "익명 로그인"은 제외 →
    // 익명 로그인을 켜도 기존 '로그인 사용자' 권한(영상·공지·출결코드·시청기록 등)이 넓어지지 않음
    function isSignedIn() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // 상담 방문자(QR로 접속한 학부모 휴대폰의 익명 세션 포함) — 상담 기록 규칙에서만 사용
    function isVisitor() {
      return request.auth != null;
    }
    // 방문자 본인이 만든 상담 기록인지 (만든 지 24시간 이내만 — 공용 기기 보호)
    function isOwnRecentConsult(data) {
      return data.get('ownerUid', '') == request.auth.uid &&
        request.time < data.createdAt + duration.value(24, 'h');
    }
    function ownsConsult(cid) {
      let path = /databases/$(database)/documents/consultForms/$(cid);
      return exists(path) && isOwnRecentConsult(get(path).data);
    }
    // 새 상담 플로우(QR) 생성 시 형식 확인: 본인 uid · 서버 시각 · 처음 상태
    function validVisitorConsultCreate() {
      let d = request.resource.data;
      return d.ownerUid == request.auth.uid
        && d.flowVersion == 2
        && d.createdAt == request.time
        && d.stage == 'form_completed'
        && d.parentSurvey.status == 'not_started'
        && d.studentSurvey.status == 'not_started'
        && d.studentName is string && d.studentName.size() <= 40
        && d.parentPhone is string && d.parentPhone.size() <= 20;
    }
    // 설명회 참석 신청(seminar.html) 생성 시 형식 확인: 서버 시각 · 관 구분 · 이름/연락처 길이 · 허용된 항목만
    function validSeminarRsvpCreate() {
      let d = request.resource.data;
      return d.createdAt == request.time
        && d.status == 'new'
        && d.branch in ['산본관', '평촌관']
        && d.parentName is string && d.parentName.size() >= 1 && d.parentName.size() <= 40
        && d.parentPhone is string && d.parentPhone.size() >= 9 && d.parentPhone.size() <= 20
        && d.studentName is string && d.studentName.size() >= 1 && d.studentName.size() <= 40
        && d.studentPhone is string && d.studentPhone.size() <= 20
        && d.grade is string && d.grade.size() <= 20
        && (!('hopeSchool' in d) || (d.hopeSchool is string && d.hopeSchool.size() <= 40))
        && d.privacyAgreed == true
        && d.keys().hasOnly(['eventTitle', 'branch', 'sessionWhen', 'parentName', 'parentPhone',
                             'studentName', 'studentPhone', 'grade', 'hopeSchool', 'privacyAgreed', 'status', 'source', 'createdAt']);
    }
    // 설명회 후속 상담 신청 (seminar-followup.html) — 2026.10.30
    function validSeminarFollowupCreate() {
      let d = request.resource.data;
      return d.createdAt == request.time
        && d.status == 'new'
        && d.branch in ['산본관', '평촌관']
        && d.parentName is string && d.parentName.size() >= 1 && d.parentName.size() <= 40
        && d.parentPhone is string && d.parentPhone.size() >= 9 && d.parentPhone.size() <= 20
        && d.studentName is string && d.studentName.size() >= 1 && d.studentName.size() <= 40
        && d.grade is string && d.grade.size() <= 20
        && d.date1 is string && d.date1.size() >= 8 && d.date1.size() <= 10
        && d.time1 is string && d.time1.size() >= 1 && d.time1.size() <= 40
        && d.date2 is string && d.date2.size() <= 10
        && d.time2 is string && d.time2.size() <= 40
        && d.note is string && d.note.size() <= 500
        && d.privacyAgreed == true
        && d.keys().hasOnly(['eventTitle', 'branch', 'parentName', 'parentPhone', 'studentName', 'grade',
                             'date1', 'time1', 'date2', 'time2', 'note', 'privacyAgreed', 'status', 'source', 'createdAt']);
    }
    // 설명회 후기 (seminar-followup.html) — 2026.10.30
    function validSeminarReviewCreate() {
      let d = request.resource.data;
      return d.createdAt == request.time
        && d.status == 'new'
        && d.branch in ['산본관', '평촌관']
        && d.rating is int && d.rating >= 1 && d.rating <= 5
        && d.content is string && d.content.size() >= 10 && d.content.size() <= 1000
        && d.authorName is string && d.authorName.size() <= 40
        && d.grade is string && d.grade.size() <= 20
        && d.publicOk is bool
        && d.privacyAgreed == true
        && d.keys().hasOnly(['eventTitle', 'branch', 'rating', 'content', 'authorName', 'grade',
                             'publicOk', 'privacyAgreed', 'status', 'source', 'createdAt']);
    }
    // 원장 계정(원장 페이지 r-038e0aee5f139320.html에 들어가는 관리자 계정 2개) — 모든 기록을 볼 수 있음
    function isDirector() {
      return isSignedIn() && request.auth.token.email in ['smc1823@nate.com', 'dncksfly@naver.com'] &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isTeacher() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function isStudent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid));
    }
    // 학부모 계정(parents/{uid}) — 학생 1명에 연결. 자기 아이 자료만 읽음
    function isParent() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/parents/$(request.auth.uid));
    }
    function parentChildId() {
      return get(/databases/$(database)/documents/parents/$(request.auth.uid)).data.studentId;
    }
    function isParentOf(studentId) {
      return isParent() && parentChildId() == studentId;
    }

    // ── admins: 관리자만 접근 (자기 자신 문서 읽기만 예외적으로 허용) ──
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // ── teachers: 선생님 본인 문서 읽기/일부 수정, 관리자는 전체 관리 ──
    match /teachers/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin() || isTeacher());
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow create, delete: if isAdmin();
    }

    // ── parents: 학부모 계정 ↔ 학생 연결. 본인 문서 읽기, 생성·수정은 관리자만 ──
    match /parents/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher() || isAdmin());
      allow write: if isAdmin();
      // 학부모 앱 푸시 토큰은 본인이 그 필드만 수정 가능
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken']);
    }

    // ── students: 학생 본인·학부모 읽기, 선생님/관리자는 전체 조회 및 관리 ──
    match /students/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isParentOf(uid) || isTeacher() || isAdmin());
      allow write: if isAdmin() || isTeacher();
      // 앱 푸시 토큰: 본인 계정이 parentFcmToken(예전 학부모 방식)·fcmToken(학생 마이페이지 숙제 알림) 필드만 수정하는 건 허용
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentFcmToken', 'fcmToken']);
    }

    // ── consultForms: 상담 기록 ──
    // · 비로그인 방문자도 상담 신청 "생성"은 가능 (홈페이지 consult.html 등 기존 방식 — ownerUid 없는 문서)
    // · 새 상담 플로우(QR 상담지): 익명 방문자 본인 uid를 ownerUid로 넣어 생성하고,
    //   본인 기록만 24시간 동안 단건 조회(get)·이어쓰기 가능. 목록 조회 불가.
    //   이어쓰기는 상담신청서 항목·학부모/학생 설문 요약·진행 상태만 (소유자·생성 시각 등은 변경 불가)
    //   (학생 설문: 학생이 함께 온 경우 같은 휴대폰에서 이어서 작성 — 2026.10)
    // · 전체 조회/수정/삭제는 관리자만 (관리자 페이지 안에서 진행하는 설문은 관리자 로그인 상태로 저장)
    match /consultForms/{docId} {
      allow create: if isAdmin()
        || !('ownerUid' in request.resource.data)
        || (isVisitor() && validVisitorConsultCreate());
      allow read, update, delete: if isAdmin();
      allow get: if isVisitor() && (resource == null || isOwnRecentConsult(resource.data));
      allow update: if isVisitor() && isOwnRecentConsult(resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'level', 'branch', 'studentName', 'schoolGrade', 'parentPhone', 'studentPhone',
          'visitPath', 'visitPathEtc', 'examScores', 'strongAreas', 'weakAreas', 'selfCheck',
          'highSubjects', 'highLevel', 'progressGrade', 'progressSemester', 'progressUnit',
          'visitWith', 'formSavedAt', 'updatedAt', 'parentSurvey', 'studentSurvey', 'stage', 'video', 'completedAt'
        ]);
    }

    // ── learningProfiles: 학습 성향 설문 결과 (learning-profile.html) ──
    // 문서 ID = 상담ID_parent / 상담ID_student → 여러 번 저장해도 중복 없음, 학부모·학생 결과는 따로 보관
    // · 관리자: 전체 조회·저장
    // · 상담 방문자(QR): 본인이 만든 상담 기록의 학부모·학생 설문만 24시간 동안 조회·저장
    //   (학생 설문은 학부모 설문을 마친 같은 휴대폰에서 이어서 진행)
    match /learningProfiles/{docId} {
      allow read, write: if isAdmin();
      allow get: if isVisitor() && docId.matches('^[A-Za-z0-9]{1,40}_(parent|student)$')
        && ownsConsult(docId.split('_')[0]);
      allow create, update: if isVisitor()
        && request.resource.data.role in ['parent', 'student']
        && docId == request.resource.data.consultId + '_' + request.resource.data.role
        && ownsConsult(request.resource.data.consultId);
    }

    // ── consultConfig: 상담 안내 영상(video)·상담 라운지 샘플 강의(lounge) 설정 (admin.html 상담 신청 탭에서 등록).
    // 방문자 화면(비로그인·익명)에서 읽어야 하므로 읽기 공개(개인정보 없음), 수정은 관리자만 ──
    match /consultConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── 각종 업무 리포트: 선생님 본인 작성분 생성/수정, 관리자는 전체 관리 ──
    match /dailyDrafts/{docId} {
      allow read, write: if isTeacher() || isAdmin();
    }
    match /weeklyReports/{docId} {
      allow read, write: if isTeacher() || isAdmin();
      // 학부모: 자기 아이 주간성취도 읽기
      allow read: if isParent() && resource != null && resource.data.studentId == parentChildId();
    }
    match /monthlyReports/{docId} {
      allow read, write: if isTeacher() || isAdmin();
    }
    match /progressReports/{docId} {
      allow read, write: if isTeacher() || isAdmin();
    }
    match /satClinicReports/{docId} {
      allow read, write: if isTeacher() || isAdmin();
    }

    // ── 일일테스트(초·중등 월말보고서 원본): 시험지 메타·문항별 유형(dailyTests), 학생별 오답(dailyTestResults).
    // 선생님은 본인 담당분 생성·수정, 관리자(원장)는 전체 — 월말 정리 때 관리자가 읽어 보고서 생성 ──
    match /dailyTests/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    match /dailyTestResults/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    // ── worksheets: 문제 DB로 만든 학습지(학습지만들기.html). 선생님 본인 것 생성·수정·삭제, 선생님·관리자 전체 읽기 ──
    // 출제·오답 입력은 위 dailyTests / dailyTestResults(source == 'worksheet')에 그대로 저장 → 월말보고서 집계에 함께 들어감
    match /worksheets/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }
    // ── studentReports: 월말 학습 보고서(생성본). 관리자가 생성, 담당 선생님 검수·수정,
    // 발송 확정된 보고서(status == 'sent')는 해당 학생(=학부모 계정)이 본인 것만 열람 ──
    match /studentReports/{docId} {
      allow read: if isTeacher() || isAdmin()
        || (isSignedIn() && resource != null && resource.data.status == 'sent'
            && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId)));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      // 학부모·학생: 공개된 자기 보고서에 '본 시각'만 기록 (새 보고서 알림 해제용)
      allow update: if isSignedIn() && resource.data.status == 'sent'
        && (resource.data.studentId == request.auth.uid || isParentOf(resource.data.studentId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentViewedAt']);
    }

    // ── 영상 관련: 로그인 사용자(학생/선생님/관리자)는 조회만, 등록/수정은 관리자만 ──
    match /videos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /videoGroups/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /apexVideos/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── videoProgress: 학생 본인 시청기록만 생성/수정(대리 조작 방지 위해 studentUid·문서ID 검증),
    // 삭제는 불가(관리자만), 선생님/관리자는 전체 조회, 학생은 본인 기록만 조회 ──
    match /videoProgress/{docId} {
      allow read: if isTeacher() || isAdmin() ||
        (isSignedIn() && resource != null && resource.data.studentUid == request.auth.uid);
      allow create, update: if isSignedIn() &&
        request.resource.data.studentUid == request.auth.uid &&
        docId == request.auth.uid + '_' + request.resource.data.videoId;
      allow delete: if isAdmin();
    }

    // ── promoVideos: 로비 TV 홍보영상 재생용. 비로그인 키오스크 페이지(promo-player.html)에서도
    // 읽어야 하므로 읽기는 전체 공개, 등록/수정/삭제는 관리자만 ──
    match /promoVideos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── notices: 학원(관리자)이 작성, 로그인한 사람(학생·학부모 포함)은 읽기만 ──
    match /notices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════
    // ── [신규] 출결체크 관련 규칙 ──
    // ══════════════════════════════════════════════

    // settings/dailyCode: 로그인한 사람(학생 포함)은 오늘의 코드를 읽을 수 있어야
    // 인증번호 대조가 가능함. 코드 생성/변경은 관리자만.
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // attendance: 등원·하원 기록 (문서 id = 학생uid_날짜)
    //  · 학생 본인: 등원 기록 생성(uid 일치), 등원 뒤 하원 칸(outTime·outAt·outMethod)만 한 번 추가
    //  · 학부모: 자기 자녀 기록만 조회 (학부모 앱 「오늘 등원·하원」·출결 탭)
    //  · 관리자: 휴대폰 없는 학생 수동 등원·하원, 수정·삭제
    //  · 선생님: 조회
    match /attendance/{docId} {
      allow create: if isSignedIn() &&
        (request.resource.data.uid == request.auth.uid || isAdmin());
      allow read: if isSignedIn() &&
        (resource == null || resource.data.uid == request.auth.uid || isParentOf(resource.data.uid) || isTeacher() || isAdmin());
      allow update: if isAdmin() ||
        (isSignedIn() && resource.data.uid == request.auth.uid
          && resource.data.get('outTime', null) == null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outTime', 'outAt', 'outMethod']));
      allow delete: if isAdmin();
    }

    // absences: 결석 사유서
    //  · 학부모: 자기 자녀 것만 제출(source='parent')·조회, 아직 지나지 않은 본인 제출분은 취소(삭제) 가능
    //  · 관리자: 전체 조회·전화 접수 입력·확인·삭제
    //  · 선생님: 조회, 「확인」 표시(readByTeacher)만 수정
    match /absences/{docId} {
      allow read: if isAdmin() || isTeacher() || (isParent() && resource.data.studentId == parentChildId());
      allow create: if isAdmin() || (isParent()
        && request.resource.data.studentId == parentChildId()
        && request.resource.data.source == 'parent'
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.readByAdmin == false
        && request.resource.data.dates is list && request.resource.data.dates.size() >= 1 && request.resource.data.dates.size() <= 31
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 40
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 1000);
      allow update: if isAdmin() ||
        (isTeacher() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTeacher']));
      allow delete: if isAdmin() ||
        (isParent() && resource.data.studentId == parentChildId() && resource.data.source == 'parent');
    }

    // appStatus: 앱(홈 화면 아이콘) 설치·알림 현황 — 본인이 앱으로 로그인할 때 기록, 관리자·선생님 조회
    match /appStatus/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isTeacher() || isAdmin());
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['role', 'studentId', 'name', 'platform', 'installed', 'pushOn', 'firstSeen', 'lastSeen']);
      allow delete: if isAdmin();
    }

    // ── timetables: 선생님 시간표 (클리닉실 자동계산용). 조교/선생님/관리자는 읽기만, 등록·수정은 관리자만 ──
    match /timetables/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── homeworks: 숙제 업로드. 조교/선생님/관리자 읽기, 등록·수정은 관리자만 ──
    match /homeworks/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── answerKeys: 답지 링크. 조교/선생님/관리자 읽기, 등록·수정은 관리자만 ──
    match /answerKeys/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── taTasks: 조교 작업물 링크. 조교/선생님/관리자 읽기, 등록·수정은 관리자만 ──
    match /taTasks/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── scheduleEvents: 학원 일정(선생님 페이지 📅 일정 달력). 선생님/관리자 읽기, 등록·수정은 관리자만 ──
    match /scheduleEvents/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── officeCalendar: 관리부 홈 화면 이번 주 달력(평촌관·산본관 상담·회의 일정). 관리자 읽기·쓰기,
    // 보이는 범위가 「선생님까지」(visibility == 'teachers')인 일정은 선생님도 읽기만 가능 ──
    match /officeCalendar/{docId} {
      allow read, write: if isAdmin();
      allow read: if isTeacher() && resource.data.visibility == 'teachers';
    }
    // ── officeCalendarPrivate/{uid}/events: 관리부 달력 「나만」 일정 — 입력한 본인 계정만 읽기·쓰기 ──
    // (원장 계정은 모든 관리자의 「나만」 일정까지 읽기 가능 — 원장 페이지 「관리부 달력 · 전체」)
    match /officeCalendarPrivate/{uid}/events/{docId} {
      allow read, write: if isAdmin() && request.auth.uid == uid;
      allow read: if isDirector();
    }
    // 원장 페이지에서 모든 관리자의 「나만」 일정을 한 번에 불러올 때(컬렉션 그룹 조회) — 원장 계정만 읽기
    match /{path=**}/events/{docId} {
      allow read: if isDirector();
    }

    // ── teacherTodos: 선생님 '내 할 일' + '해야 할 업무' 완료 체크(kind: 'autoCheck').
    // 선생님은 본인(uid) 문서만 읽기·추가·수정·삭제, 관리자는 전체 ──
    match /teacherTodos/{docId} {
      allow read, delete: if isAdmin() || (isTeacher() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin() || (isTeacher() && resource.data.uid == request.auth.uid
                                     && request.resource.data.uid == request.auth.uid);
      allow create: if isAdmin() || (isTeacher() && request.resource.data.uid == request.auth.uid);
    }

    // ── consultDecks: 학부모 상담 프레젠테이션(consult-deck.html) 내용과 편집 보관본.
    // 열람·편집 모두 관리자 로그인 전용 (consult-deck-admin.html에서 저장) ──
    match /consultDecks/{deckId} {
      allow read, write: if isAdmin();
      match /history/{histId} {
        allow read, write: if isAdmin();
      }
    }

    // ── seminarConfig: 설명회 안내 설정(seminar.html 첫 화면 · 홈 배너). 누구나 읽기, 수정은 관리자만 ──
    match /seminarConfig/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── seminarRsvps: 설명회 참석 신청(seminar.html). 비로그인 방문자도 형식에 맞는 신청 "생성"만 가능,
    //    목록 조회·참석 체크·메모·삭제는 관리자만 ──
    match /seminarRsvps/{docId} {
      allow create: if isAdmin() || validSeminarRsvpCreate();
      allow read, update, delete: if isAdmin();
    }

    // ── seminarFollowups: 설명회 후속 상담 신청 · seminarReviews: 설명회 후기 (seminar-followup.html)
    //    비로그인 방문자는 형식에 맞는 "생성"만, 조회·연락 완료 표시·삭제는 관리자만 ──
    match /seminarFollowups/{docId} {
      allow create: if isAdmin() || validSeminarFollowupCreate();
      allow read, update, delete: if isAdmin();
    }
    match /seminarReviews/{docId} {
      allow create: if isAdmin() || validSeminarReviewCreate();
      allow read, update, delete: if isAdmin();
    }

    // ── reportComments: 주간성취도·월간보고서에 대한 학부모 댓글과 선생님 답글.
    //    학부모: 자기 아이 것만 읽기·작성(authorRole=parent), 읽음 표시(readByParent)만 수정
    //    선생님: 자기 담당(teacherUid) 것만 읽기·답글(authorRole=teacher), 읽음 표시(readByTeacher)만 수정
    //    관리자: 전체 ──
    match /reportComments/{docId} {
      allow read: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid)
        || (isParent() && resource.data.studentId == parentChildId());
      allow create: if isAdmin()
        || (isTeacher() && request.resource.data.authorRole == 'teacher'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.teacherUid == request.auth.uid)
        || (isParent() && request.resource.data.authorRole == 'parent'
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.studentId == parentChildId()
            && request.resource.data.text is string && request.resource.data.text.size() <= 2000);
      allow update: if isAdmin()
        || (isTeacher() && resource.data.teacherUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByTeacher']))
        || (isParent() && resource.data.studentId == parentChildId()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByParent']))
        // 본인이 쓴 글은 내용만 수정 가능
        || (isSignedIn() && resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string && request.resource.data.text.size() <= 2000);
      allow delete: if isAdmin()
        || (isTeacher() && resource.data.authorUid == request.auth.uid)
        || (isParent() && resource.data.authorUid == request.auth.uid);
    }

    // ── homeworkLogs: 날짜별 반 숙제(담당·반·학생·내용) — 관리부 숙제 입력 + 선생님 페이지 숙제 입력 공용.
    //    관리자 전체 입력·수정, 선생님은 본인(teacherUid) 반 숙제만 입력·수정·삭제,
    //    학부모·학생은 자기(아이)가 포함된 것만 읽기 ──
    match /homeworkLogs/{docId} {
      allow read: if isTeacher() || isAdmin()
        || (isParent() && resource.data.studentIds.hasAny([parentChildId()]))
        || (isStudent() && resource.data.studentIds.hasAny([request.auth.uid]));
      allow create: if isAdmin() || (isTeacher() && request.resource.data.teacherUid == request.auth.uid);
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid
                                    && request.resource.data.teacherUid == request.auth.uid);
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ── meetingDocs: 회의 자료(제목·날짜·메모·PDF 경로). 선생님·관리자 읽기, 관리자만 쓰기 ──
    match /meetingDocs/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow write: if isAdmin();
    }

    // ── examMaterials: 평촌 학원 연합 기말고사 대비 페이지(/exam) 자료 목록.
    // exam 페이지는 로그인 없이(학원별 인증번호로만) 접근하므로 읽기는 전체 공개,
    // 등록/수정/삭제(admin.html "기말고사 자료" 탭)는 관리자만 ──
    match /examMaterials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── questions: /exam 질문 게시판(qna.html). 로그인 없이 인증번호로만 접근하므로
    // 생성/조회는 공개. 답변은 answer/answered/answeredBy 필드만 수정 가능.
    // 삭제도 인증번호 기반이라 규칙에서 선생님 여부를 확인할 수 없어 공개 ──
    match /questions/{docId} {
      allow read: if true;
      allow create: if true;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['answer', 'answered', 'answeredBy']);
      allow delete: if true;
    }

    // ── motivationVideos: /exam "공부하기 싫을때" 유튜브 영상 목록(motivation.html).
    // 선생님 인증번호로 등록·삭제(로그인 없음). 등록 시 허용된 항목·길이만 ──
    match /motivationVideos/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['title', 'youtubeId', 'academy', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.youtubeId is string && request.resource.data.youtubeId.size() <= 20
        && request.resource.data.academy is string && request.resource.data.academy.size() <= 40;
      allow update: if false;
      allow delete: if true;
    }

    // ── examUploads: /exam 기말고사 자료를 각 학원 선생님이 직접 올리는 목록(exam/upload.html).
    // 로그인 없이 학원별 업로드 인증번호로만 들어오므로, 등록 시 항목·값을 엄격하게 제한.
    // 학생 화면(materials.html)에는 영상만, PDF는 선생님 인증번호로 들어온 화면에만 노출 ──
    match /examUploads/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['academy', 'subject', 'kind', 'source', 'title', 'grade', 'materialType', 'year', 'url', 'storagePath', 'size', 'createdAt', 'downloadable', 'videoDocId', 'hidden'])
        && request.resource.data.academy in ['송우찬수학학원', '인어스수학학원', '대치레몬학원', '에이펙스영어학원']
        && request.resource.data.kind in ['video', 'pdf']
        && request.resource.data.source in ['file', 'youtube', 'vimeo']
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 120
        && request.resource.data.url is string && request.resource.data.url.size() <= 2000
        && (!('downloadable' in request.resource.data) || request.resource.data.downloadable is bool)
        && (!('videoDocId' in request.resource.data) || (request.resource.data.videoDocId is string && request.resource.data.videoDocId.size() <= 40))
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
      // 수정은 영상↔PDF 연결(videoDocId)·공개/비공개(hidden)만 가능
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videoDocId', 'hidden'])
        && (!('videoDocId' in request.resource.data) || (request.resource.data.videoDocId is string && request.resource.data.videoDocId.size() <= 40))
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool);
      allow delete: if true;
    }

    // ── examScores: 학교 시험 점수 (teacher.html "시험 점수 입력") — 문서 id: 시험키_학생id
    // 선생님은 지금 본인 담당 학생(students.teacherUid == 나)의 점수만 입력·수정, 본인이 입력한 것만 조회. 관리자는 전체 ──
    match /examScores/{docId} {
      allow read: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
      allow create, update: if isAdmin() || (isTeacher()
        && request.resource.data.teacherUid == request.auth.uid
        && request.resource.data.studentId is string
        && get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.teacherUid == request.auth.uid
        && request.resource.data.status in ['응시', '미응시', '해당없음']
        && (request.resource.data.score == null
            || ((request.resource.data.score is int || request.resource.data.score is float)
                && request.resource.data.score >= 0 && request.resource.data.score <= 100)));
      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);
    }

    // ── subMaterials: 학교별 부교재 프린트 목록 (teacher.html "부교재 프린트") — 파일은 Storage subMaterials/{id}/
    // 선생님·관리자 열람, 선생님은 본인 이름으로 올림, 수정·삭제는 올린 선생님 또는 관리자 ──
    match /subMaterials/{docId} {
      allow read: if isTeacher() || isAdmin();
      allow create: if isAdmin() || (isTeacher() && request.resource.data.uploaderUid == request.auth.uid
        && request.resource.data.branch in ['평촌관', '산본관']);
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.uploaderUid == request.auth.uid);
    }

    // ── 그 외 정의되지 않은 컬렉션: 기본적으로 관리자만 접근 가능 ──
    // (단, officeCalendarPrivate는 「나만」 일정이라 다른 관리자에게도 열지 않음 — 위 규칙으로 본인만)
    match /{col}/{document=**} {
      allow read, write: if isAdmin() && col != 'officeCalendarPrivate';
    }
  }
}
